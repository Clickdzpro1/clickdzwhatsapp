# ----- Server -----
PORT=3000
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173

# ----- Database -----
DATABASE_URL=postgresql://user:password@host:5432/clickdz_whatsapp
REDIS_URL=redis://localhost:6379

# ----- AI (current provider) -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# ----- Billing -----
TRIAL_BUDGET=5.00
WEEKLY_PRICE=7.00
SLICKPAY_API_KEY=
SLICKPAY_SECRET=

# ----- WhatsApp bridge (legacy, in-process) -----
MAX_BRIDGES_PER_SERVER=50
BRIDGE_RAM_MB=100

# ----- Wave 0: Railway WhatsApp Gateway proxy -----
# Set USE_RAILWAY_GATEWAY=true once the Railway service is provisioned with
# a per-tenant API key (see whatsapp-gateway repo, /admin/tenants). While
# false, the SaaS keeps the legacy in-process Baileys bridge (the source of
# the QR-loop bug) so existing tenants continue to function.
USE_RAILWAY_GATEWAY=false

# Public base URL of the Railway service. Examples:
#  - https://wweb-gateway-<env>.up.railway.app  (whatsapp-web.js + Chromium)
#  - https://gateway-<env>.up.railway.app       (Baileys, lighter weight)
# In production pick *one* of the two engines; see the Wave 2 plan for the
# reasoning (wweb gives better contact names; Baileys uses less RAM).
GATEWAY_BASE_URL=

# Per-tenant API key (issued by the gateway admin SDK on tenant creation).
# For Wave 0 we accept one global key; Wave 1 stores one row per tenant in
# the SaaS tenant_gateway_keys table.
GATEWAY_API_KEY=

# Admin key for tenant + instance provisioning. Same value as the gateway's
# ADMIN_API_KEY env on the Railway side. Used to call /admin/tenants and
# /admin/instances when the SaaS provisions new connections.
GATEWAY_ADMIN_KEY=

# Optional: request timeout when calling the gateway (ms). Default 10000.
GATEWAY_TIMEOUT_MS=10000

# ----- Wave 1+ (placeholders; do not set yet) -----
# GATEWAY_API_KEY__TENANT_{ID}=  # per-tenant rotation, see Wave 1
# GATEWAY_WEBHOOK_URL=https://<this-saas>/api/webhooks/whatsapp  # inbound
